# Copy to .env and fill in. Never commit .env.
# Names only. Add variables here when a feature needs them.

# Supabase
SUPABASE_URL=
SUPABASE_KEY=

# Model provider (keep the core model-agnostic)
LLM_API_KEY=

# Maps (planning/maps-design.md): A23 description rules block the build (default 1); 0 makes them warnings.
YGGDRAS_HARD_DESCRIPTION_RULES=1

# Lia (planning/maps-design.md, lia-v1): the brain repo she reads, and her model (D27).
YGGDRAS_BRAIN=
YGGDRAS_LIA_MODEL=claude-haiku-5-5

# Lia connector (yggdras mcp): a .env file to read ANTHROPIC_API_KEY from, if not this one.
YGGDRAS_ENV_FILE=
# Optional: the brain owner's names, comma-separated, for Lia's voice check (she says "you").
YGGDRAS_OWNER_NAMES=
# Optional: the connector's config arm, ref | A | B | C (v4 prereg); default A.
YGGDRAS_LIA_ARM=
ANTHROPIC_API_KEY=
