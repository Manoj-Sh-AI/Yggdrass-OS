# The whole Yggdras backend in one container (planning/backend-server-move.md):
# API + call scheduler, agent worker + Temporal, brain service + Lia, voice worker.
# Settings come from the host's variables at start (app/api/src/yggdress_app/hosted.py).
FROM python:3.12-slim-bookworm

ARG TEMPORAL_VERSION=1.10.1
ENV PYTHONUNBUFFERED=1 \
    UV_PYTHON=/usr/local/bin/python3.12 \
    UV_PYTHON_DOWNLOADS=never \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    YGGDRAS_HOME=/data \
    TEMPORAL_BINARY=/opt/temporal/temporal

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.11.18 /uv /usr/local/bin/uv

# Temporal CLI (local dev server), the same version as on the laptop, checked against
# the release's published checksums.
RUN set -eux; cd /tmp; \
    base="https://github.com/temporalio/cli/releases/download/v${TEMPORAL_VERSION}"; \
    curl -fsSLO "${base}/temporal_cli_${TEMPORAL_VERSION}_linux_amd64.tar.gz"; \
    curl -fsSLO "${base}/checksums.txt"; \
    grep " temporal_cli_${TEMPORAL_VERSION}_linux_amd64.tar.gz\$" checksums.txt | sha256sum -c -; \
    mkdir -p /opt/temporal; \
    tar -xzf "temporal_cli_${TEMPORAL_VERSION}_linux_amd64.tar.gz" -C /opt/temporal temporal; \
    rm -f /tmp/temporal_cli_* /tmp/checksums.txt; \
    /opt/temporal/temporal --version

WORKDIR /repo

# Dependencies first (cached between deploys): the brain/Lia project and the app.
COPY app/pyproject.toml app/uv.lock app/
COPY app/api/pyproject.toml app/api/uv.lock app/api/
RUN cd app && uv sync --frozen --no-dev --no-install-project \
 && cd api && uv sync --frozen --no-dev --extra voice --no-install-project

COPY . .
RUN cd app && uv sync --frozen --no-dev \
 && cd api && uv sync --frozen --no-dev --extra voice

CMD ["/repo/app/api/.venv/bin/python", "-m", "yggdress_app.hosted"]
