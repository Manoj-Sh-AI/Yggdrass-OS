{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-verify/types/**/*.ts",
    ".next-verify/dev/types/**/*.ts",
    ".next-note-work/types/**/*.ts",
    ".next-note-work/dev/types/**/*.ts",
    ".next-foundations/types/**/*.ts",
    ".next-foundations/dev/types/**/*.ts",
    ".next-desktop/types/**/*.ts",
    ".next-desktop/dev/types/**/*.ts",
    ".next-connected/types/**/*.ts",
    ".next-connected/dev/types/**/*.ts",
    ".next-connected-polish/types/**/*.ts",
    ".next-connected-polish/dev/types/**/*.ts",
    ".next-agents/types/**/*.ts",
    ".next-agents/dev/types/**/*.ts",
    ".next-agents-release/types/**/*.ts",
    ".next-agents-release/dev/types/**/*.ts",
    ".next-agents-final/types/**/*.ts",
    ".next-agents-final/dev/types/**/*.ts",
    ".next-agents-ready/types/**/*.ts",
    ".next-agents-ready/dev/types/**/*.ts",
    ".next-temporal-ready/types/**/*.ts",
    ".next-temporal-ready/dev/types/**/*.ts",
    ".next-mobile-ready/types/**/*.ts",
    ".next-mobile-ready/dev/types/**/*.ts",
    ".next-android-ready/types/**/*.ts",
    ".next-android-ready/dev/types/**/*.ts",
    ".next-phone-ready/types/**/*.ts",
    ".next-phone-ready/dev/types/**/*.ts",
    ".next-voice-ready/types/**/*.ts",
    ".next-voice-ready/dev/types/**/*.ts",
    ".next-phone-parity/types/**/*.ts",
    ".next-phone-parity/dev/types/**/*.ts",
    ".next-parity-ready/types/**/*.ts",
    ".next-parity-ready/dev/types/**/*.ts",
    ".next-catalogs/types/**/*.ts",
    ".next-catalogs/dev/types/**/*.ts",
    ".next-connectors/types/**/*.ts",
    ".next-connectors/dev/types/**/*.ts",
    ".next-logos/types/**/*.ts",
    ".next-logos/dev/types/**/*.ts",
    ".next-reminders/types/**/*.ts",
    ".next-reminders/dev/types/**/*.ts",
    ".next-calls-v3/types/**/*.ts",
    ".next-calls-v3/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
