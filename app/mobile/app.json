{
  "expo": {
    "name": "Yggdras",
    "slug": "yggdras",
    "scheme": "yggdras",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "app.yggdras.mobile",
      "permissions": ["RECORD_AUDIO", "POST_NOTIFICATIONS", "USE_FULL_SCREEN_INTENT"],
      "googleServicesFile": "./google-services.json"
    },
    "ios": { "bundleIdentifier": "app.yggdras.mobile" },
    "plugins": [
      ["expo-notifications", { "androidMode": "default" }]
    ],
    "extra": {
      "note": "The backend URL is set at sign-in, never here; no keys live in this file."
    }
  }
}
