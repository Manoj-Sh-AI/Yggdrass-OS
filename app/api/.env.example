# Configure privately; these are names only, not working credentials.
YGGDRESS_DATABASE_URL=
YGGDRESS_MIGRATION_DATABASE_URL=
YGGDRESS_PASSWORD_HASH=
YGGDRESS_ORIGIN=
YGGDRESS_BRAIN_MODE=mock
# Set to 1 only for loopback HTTP development; HTTPS sessions otherwise.
YGGDRESS_LOCAL_HTTP=0
# Notes-only proxy. Server-side environment; never use NEXT_PUBLIC_ names.
BRAIN_SERVER_URL=http://localhost:8100
BRAIN_API_USER=
BRAIN_API_PASSWORD=
# Web Push for the browser/PWA. These server variables are optional.
# PUBLIC_KEY is the base64url uncompressed P-256 public point; PRIVATE_KEY is the
# matching pywebpush-compatible private key. SUBJECT is the operator's mailto: URI.
YGGDRAS_VAPID_PUBLIC_KEY=
YGGDRAS_VAPID_PRIVATE_KEY=
YGGDRAS_VAPID_SUBJECT=
# Supported LiveKit Inference LLM id selected by the operator for pre-task calls.
YGGDRAS_REMINDER_LLM=
